{
  "tasks": {
    "check": "deno task typecheck && deno task fix && deno task lint",
    "fix": "dprint fmt",
    "lint": "deno lint",
    "dev": "deno run --allow-net --allow-read --allow-env=NODE_DEBUG --watch main.ts --dev",
    "serve": "deno run --allow-net --allow-read --allow-env=NODE_DEBUG main.ts",
    "update": "dprint config update && deno run -A 'https://deno.land/x/udd@0.5.0/main.ts' main.ts",
    "typecheck": "deno check ./main.ts"
  },
  "compilerOptions": {
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true
  },
  "lint": {
    "include": ["./"],
    "exclude": [
      "**/fixtures",
      "**/snapshots"
    ],
    "rules": {
      "tags": ["recommended"],
      "include": [],
      "exclude": ["ban-types"]
    }
  }
}
